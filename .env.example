# Application
APP_NAME=barekat-genomics
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Database
DATABASE_URL=postgresql://barekat:barekat@localhost:5432/barekat_genomics

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (FASTQ/BAM files)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=barekat
S3_SECRET_KEY=barekatsecret
S3_BUCKET=barekat-genomics
S3_REGION=us-east-1

# HIPAA / Security
ENCRYPTION_KEY=change-me-32-byte-key-for-phi!!
AUDIT_LOG_ENABLED=true
PHI_RETENTION_DAYS=2555

# Reference Databases
DBSNP_PATH=/data/reference/dbsnp
GENOME_BUILD=GRCh38

# ML Models
MODEL_PATH=/data/models
VARIANT_CLASSIFIER_MODEL=variant_classifier_v1.pkl
