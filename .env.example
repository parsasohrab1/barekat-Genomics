# Application
APP_NAME=barekat-genomics
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
AUTH_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=postgresql://barekat:barekat@localhost:5432/barekat_genomics

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (FASTQ/BAM files)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=barekat
S3_SECRET_KEY=barekatsecret
S3_BUCKET=barekat-genomics
S3_REGION=us-east-1

# HIPAA / Security
ENCRYPTION_KEY=change-me-32-byte-key-for-phi!!
AUDIT_LOG_ENABLED=true
PHI_RETENTION_DAYS=2555

# Reference Databases
DBSNP_PATH=/data/reference/dbsnp
GENOME_BUILD=GRCh38
REFERENCE_DIR=/data/reference/GRCh38
REF_FASTA=/data/reference/GRCh38/GRCh38.fa
BWA_INDEX_PREFIX=/data/reference/GRCh38/GRCh38/GRCh38
SNPEFF_DB=GRCh38.99
CLINVAR_PATH=/data/reference/GRCh38/clinvar/clinvar.vcf.gz
PHARMGKB_PATH=/data/reference/GRCh38/pharmgkb
KNOWLEDGE_DIR=data/reference/knowledge
GNOMAD_PATH=/data/reference/gnomad

# Pipeline (simulated | production)
PIPELINE_MODE=simulated
PIPELINE_WORK_DIR=/data/processed
PIPELINE_BACKEND=celery
PIPELINE_WORKFLOW_ENGINE=native

# Nextflow
NEXTFLOW_EXECUTABLE=nextflow
NEXTFLOW_WORKFLOW_PATH=workflows/nextflow/main.nf
NEXTFLOW_PROFILE=standard
NEXTFLOW_EXECUTOR=

# Kubernetes
KUBERNETES_NAMESPACE=barekat
KUBERNETES_JOB_TEMPLATE=k8s/pipeline-job.yaml
KUBERNETES_WORKER_IMAGE=barekat-genomics-worker:latest

# AWS Batch
AWS_REGION=eu-central-1
AWS_BATCH_JOB_QUEUE=
AWS_BATCH_JOB_DEFINITION=

# Annotation cache
ANNOTATION_CACHE_ENABLED=true
ANNOTATION_CACHE_TTL_SECONDS=604800

# AI Decision Support (no direct diagnosis — assist only)
AI_ASSIST_ENABLED=true

# Observability
METRICS_ENABLED=true
LOG_JSON=false
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_RELEASE=barekat-genomics@0.1.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# ML Models
MODEL_PATH=data/models
VARIANT_CLASSIFIER_MODEL=variant_classifier_v1.pkl
ML_AB_TEST_ENABLED=false
ML_AB_TEST_CHALLENGER=v2
ML_AB_TEST_TRAFFIC_PCT=0.1
