# Staging environment — do not use in production without rotating secrets
APP_NAME=barekat-genomics
APP_ENV=staging
DEBUG=false
API_PREFIX=/api/v1
SECRET_KEY=staging-change-me-use-openssl-rand-hex-32
AUTH_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=480

DATABASE_URL=postgresql://barekat:barekat_staging@postgres:5432/barekat_genomics_staging

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=barekat
S3_SECRET_KEY=barekatstagingsecret
S3_BUCKET=barekat-genomics-staging
S3_REGION=us-east-1

ENCRYPTION_KEY=staging-32-byte-key-for-phi!!!!
AUDIT_LOG_ENABLED=true
PHI_RETENTION_DAYS=2555

GENOME_BUILD=GRCh38
REFERENCE_DIR=/data/reference/GRCh38
PIPELINE_MODE=simulated
PIPELINE_WORK_DIR=/data/processed
PIPELINE_BACKEND=celery

MODEL_PATH=/data/models
VARIANT_CLASSIFIER_MODEL=variant_classifier_v1.pkl
KNOWLEDGE_DIR=/data/reference/knowledge

AI_ASSIST_ENABLED=true
METRICS_ENABLED=true
LOG_JSON=true
LOG_LEVEL=INFO
